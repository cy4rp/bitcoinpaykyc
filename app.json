{
  "expo": {
    "name": "BitcoinPayKYC",
    "slug": "bitcoinpaykyc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yulfoundation.bitcoinpaykyc",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to camera for KYC identity verification.",
        "NSPhotoLibraryUsageDescription": "This app needs access to photo library to upload identity documents.",
        "NSFaceIDUsageDescription": "This app uses Face ID for biometric authentication."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.yulfoundation.bitcoinpaykyc"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "expo-local-authentication"
    ]
  }
}
